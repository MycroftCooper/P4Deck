{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "P4Deck",
  "version": "0.1.9",
  "identifier": "dev.p4deck.desktop",
  "build": {
    "beforeDevCommand": "node ./scripts/dev-frontend.mjs --port 1422",
    "devUrl": "http://127.0.0.1:1422",
    "beforeBuildCommand": "node ./scripts/build-frontend.mjs --mode desktop",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "P4Deck",
        "width": 1280,
        "height": 800,
        "minWidth": 390,
        "minHeight": 620,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "P4Deck",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDg4Qjk0RDYxNzcwRkNEOEEKUldTS3pROTNZVTI1aU5wMXVuS0VLdWVZcFFPUzlsWVF0M1NlMHh1dDVpbzlhTjFMamJBczFuQ3QK",
      "requireSignedVersion": true,
      "endpoints": [
        "https://github.com/MycroftCooper/p4deck-releases/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
