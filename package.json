{
  "name": "p4deck",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=24.0.0 <25",
    "pnpm": ">=11.19.0 <12"
  },
  "scripts": {
    "dev": "vite",
    "dev:desktop:frontend": "node scripts/dev-frontend.mjs --port 1422",
    "dev:desktop": "tauri dev",
    "dev:desktop:qa": "node scripts/dev-desktop-qa.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"scripts/*.mjs\"",
    "build": "node scripts/build-frontend.mjs",
    "build:desktop": "node scripts/build-frontend.mjs --mode desktop",
    "build:desktop:win": "node scripts/build-desktop.mjs",
    "package:desktop:win": "node scripts/package-desktop.mjs",
    "preview": "vite preview",
    "check:web": "tsc -b --pretty false",
    "check": "tsc -b --pretty false && cargo check --manifest-path src-tauri/Cargo.toml",
    "test:web": "vitest run",
    "test:web:ci": "vitest run --reporter=dot",
    "test:browser": "playwright test",
    "test:a11y": "playwright test --grep axe",
    "test:perf": "node --expose-gc node_modules/vitest/vitest.mjs run --config vitest.perf.config.ts",
    "test:perf:backend": "cargo run --release --manifest-path src-tauri/Cargo.toml --features backend-perf --bin backend-perf",
    "test:ci-protocol": "node --test scripts/ci-step-result.test.mjs",
    "test:versions": "node --test scripts/validate-versions.test.mjs",
    "test:theme-contrast": "node --test scripts/theme-contrast.test.mjs",
    "validate:versions": "node scripts/validate-versions.mjs",
    "validate:bundle": "node scripts/verify-desktop-bundle.mjs",
    "validate:frontend-contracts": "node scripts/validate-frontend-contracts.mjs",
    "ci:quick": "node scripts/ci-runner.mjs quick",
    "ci:local": "node scripts/ci-runner.mjs local",
    "ci:bundle": "node scripts/ci-runner.mjs bundle",
    "wf:check": "node scripts/workflow/state.mjs check",
    "wf:board": "node scripts/workflow/state.mjs board",
    "wf:board:compact": "node scripts/workflow/state.mjs board --compact",
    "wf:queue": "node scripts/workflow/state.mjs queue",
    "wf:sync": "node scripts/workflow/sync.mjs",
    "wf:baseline": "node scripts/workflow/baseline.mjs",
    "wf:cache": "node scripts/workflow/cache.mjs",
    "wf:archive:docs": "node scripts/workflow/archive.mjs",
    "wf:cargo": "scripts\\workflow\\cargo-candidate.cmd",
    "wf:task": "node scripts/workflow/state.mjs task",
    "wf:tests": "node scripts/workflow/select-tests.mjs",
    "wf:fast": "node scripts/workflow/ci-fast.mjs",
    "wf:selftest": "node scripts/workflow/batch.selftest.mjs",
    "wf:selftest:all": "node scripts/workflow/batch.selftest.mjs && node scripts/workflow/workflow.selftest.mjs && node tools/dsh-p4deck-board/selftest.mjs && node tools/dsh-p4deck-board/selftest-client.mjs",
    "wf:evidence": "node scripts/workflow/evidence.mjs",
    "wf:evidence:collect": "node scripts/workflow/evidence.mjs --collect-temp",
    "wf:ownership": "node scripts/workflow/ownership.mjs",
    "wf:todo": "node scripts/workflow/human-todos.mjs",
    "wf:archive": "node scripts/workflow/state.mjs archive",
    "wf:restore": "node scripts/workflow/state.mjs restore",
    "wf:measure": "node scripts/workflow/measure.mjs",
    "wf:view": "node scripts/workflow/board.mjs",
    "wf:serve": "node scripts/workflow/board.mjs --serve",
    "wf:plugin:test": "node tools/dsh-p4deck-board/selftest.mjs && node tools/dsh-p4deck-board/selftest-client.mjs",
    "test:e2e:p4d:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/test-p4d-e2e.ps1",
    "test:fixture-safety:win": "powershell -NoProfile -File scripts/fixture-safety.test.ps1",
    "test": "vitest run && cargo test --manifest-path src-tauri/Cargo.toml",
    "doctor": "bash scripts/doctor.sh",
    "setup:mac": "bash scripts/setup-macos.sh",
    "setup:mac:check": "bash scripts/setup-macos.sh --check",
    "fixture:start": "bash scripts/p4d-fixture.sh start",
    "fixture:stop": "bash scripts/p4d-fixture.sh stop",
    "fixture:destroy": "bash scripts/p4d-fixture.sh destroy",
    "fixture:setup:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p4d-fixture.ps1 setup",
    "fixture:start:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p4d-fixture.ps1 start",
    "fixture:status:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p4d-fixture.ps1 status",
    "fixture:stop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p4d-fixture.ps1 stop",
    "fixture:destroy:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/p4d-fixture.ps1 destroy",
    "tauri": "tauri",
    "wf:close": "node scripts/workflow/close.mjs"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.85.5",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "dockview-react": "^8.3.1",
    "lucide-react": "^0.542.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "26.1.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
